<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="simulation" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="use_obstacle_avoidance" default="false"/>

  <node pkg="multi_purpose_mpc_ros" exec="mpc_controller_cpp"
        name="mpc_controller" output="screen"
        args="--config_path $(find-pkg-share multi_purpose_mpc_ros)/config/config.yaml
              --ref_vel_path $(find-pkg-share multi_purpose_mpc_ros)/config/ref_vel.yaml">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="simulation_mode" value="$(var simulation)"/>
    <param name="awsim_control_mode_reassert_enabled" value="true"/>
    <param name="awsim_control_mode_reassert_period_sec" value="0.2"/>
    <param name="awsim_control_mode_reassert_timeout_sec" value="5.0"/>
    <param name="awsim_control_mode_motion_threshold_mps" value="0.1"/>
    <param name="use_boost_acceleration" value="false"/>
    <param name="use_obstacle_avoidance" value="$(var use_obstacle_avoidance)"/>
    <param name="use_stats" value="false"/>
  </node>
</launch>

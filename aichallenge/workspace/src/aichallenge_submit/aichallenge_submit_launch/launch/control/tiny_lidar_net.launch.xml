<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="vscan_mode" default="false"/>
  <arg name="ckpt_path" default="$(find-pkg-share tiny_lidar_net_controller)/ckpt/tinylidarnet_weights.npy"/>
  <arg name="residual_ckpt_path" default=""/>
  <arg name="residual_architecture" default="stateless"/>
  <arg name="spatial_shadow_ckpt_path" default="$(find-pkg-share tiny_lidar_net_controller)/ckpt/spatial_steering_adapter.npy"/>
  <arg name="spatial_shadow_expected_sha256" default="f3921c265677761bcf9458c61758d997b94d0b2045e87ebcee37ca94f3ed412c"/>
  <arg name="spatial_shadow_use_base_steering" default="true"/>
  <arg name="spatial_shadow_max_abs_delta_rad" default="1.2"/>
  <arg name="spatial_authority_enabled" default="true"/>
  <arg name="spatial_authority_max_abs_delta_rad" default="1.2"/>
  <arg name="recurrent_shadow_ckpt_path" default=""/>
  <arg name="recurrent_shadow_expected_sha256" default=""/>
  <arg name="recurrent_authority_enabled" default="false"/>
  <arg name="recurrent_authority_max_abs_correction_rad" default="0.24"/>
  <arg name="model_type" default="tiny_lidar_net"/>
  <arg name="control_mode" default="fixed_lidar_brake"/>
  <arg name="acceleration" default="0.8"/>
  <arg name="maximum_forward_speed_mps" default="4.6"/>
  <arg name="csv_path" default="$(find-pkg-share laserscan_generator)/map/lane.csv"/>

  <group if="$(var vscan_mode)">
    <include file="$(find-pkg-share laserscan_generator)/launch/laserscan_generator.launch.xml">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="csv_path" value="$(var csv_path)"/>
    </include>
  </group>

  <include file="$(find-pkg-share tiny_lidar_net_controller)/launch/tiny_lidar_net.launch.xml">
    <arg name="ckpt_path" value="$(var ckpt_path)"/>
    <arg name="residual_ckpt_path" value="$(var residual_ckpt_path)"/>
    <arg name="residual_architecture" value="$(var residual_architecture)"/>
    <arg name="spatial_shadow_ckpt_path" value="$(var spatial_shadow_ckpt_path)"/>
    <arg name="spatial_shadow_expected_sha256" value="$(var spatial_shadow_expected_sha256)"/>
    <arg name="spatial_shadow_use_base_steering" value="$(var spatial_shadow_use_base_steering)"/>
    <arg name="spatial_shadow_max_abs_delta_rad" value="$(var spatial_shadow_max_abs_delta_rad)"/>
    <arg name="spatial_authority_enabled" value="$(var spatial_authority_enabled)"/>
    <arg name="spatial_authority_max_abs_delta_rad" value="$(var spatial_authority_max_abs_delta_rad)"/>
    <arg name="recurrent_shadow_ckpt_path" value="$(var recurrent_shadow_ckpt_path)"/>
    <arg name="recurrent_shadow_expected_sha256" value="$(var recurrent_shadow_expected_sha256)"/>
    <arg name="recurrent_authority_enabled" value="$(var recurrent_authority_enabled)"/>
    <arg name="recurrent_authority_max_abs_correction_rad" value="$(var recurrent_authority_max_abs_correction_rad)"/>
    <arg name="model_type" value="$(var model_type)"/>
    <arg name="control_mode" value="$(var control_mode)"/>
    <arg name="acceleration" value="$(var acceleration)"/>
    <arg name="maximum_forward_speed_mps" value="$(var maximum_forward_speed_mps)"/>
    <arg name="control_cmd_topic" value="/control/command/control_cmd"/>
  </include>
</launch>

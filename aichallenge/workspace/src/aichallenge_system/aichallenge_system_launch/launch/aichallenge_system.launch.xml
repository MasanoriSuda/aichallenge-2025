<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <arg name="simulation"/>
    <arg name="use_sim_time"/>
    <arg name="run_rviz"/>
    <arg name="sensor_model" default="racing_kart_sensor_kit"/>
    <arg name="launch_vehicle_interface" default="$(eval &quot;'$(var simulation)' == 'false'&quot;)"/>
    <arg name="capture" default="false"/>
    <arg name="rosbag" default="true"/>
    <arg name="domain_id" default="0"/>
    <arg name="vehicle_count" default="1"/>
    <arg name="control_method" default="tiny_lidar_net"/>
    <arg name="tiny_lidar_ckpt_path" default="$(find-pkg-share tiny_lidar_net_controller)/ckpt/tinylidarnet_weights.npy"/>
    <arg name="tiny_lidar_residual_ckpt_path" default=""/>
    <arg name="tiny_lidar_residual_architecture" default="stateless"/>
    <arg name="tiny_lidar_spatial_shadow_ckpt_path" default="$(find-pkg-share tiny_lidar_net_controller)/ckpt/spatial_steering_adapter.npy"/>
    <arg name="tiny_lidar_spatial_shadow_expected_sha256" default="f3921c265677761bcf9458c61758d997b94d0b2045e87ebcee37ca94f3ed412c"/>
    <arg name="tiny_lidar_spatial_shadow_use_base_steering" default="true"/>
    <arg name="tiny_lidar_spatial_shadow_max_abs_delta_rad" default="1.2"/>
    <arg name="tiny_lidar_spatial_authority_enabled" default="true"/>
    <arg name="tiny_lidar_spatial_authority_max_abs_delta_rad" default="1.2"/>
    <arg name="tiny_lidar_recurrent_shadow_ckpt_path" default=""/>
    <arg name="tiny_lidar_recurrent_shadow_expected_sha256" default=""/>
    <arg name="tiny_lidar_recurrent_authority_enabled" default="false"/>
    <arg name="tiny_lidar_recurrent_authority_max_abs_correction_rad" default="0.24"/>
    <arg name="tiny_lidar_control_mode" default="fixed_lidar_brake"/>
    <arg name="tiny_lidar_acceleration" default="0.8"/>

    <let name="domain_id" value="$(var domain_id)"/>
    <let name="rviz_config" value="$(find-pkg-share aichallenge_system_launch)/config/autoware_vehicle.rviz"/>
    <let name="rviz_config" value="$(find-pkg-share aichallenge_system_launch)/config/autoware.rviz" if="$(var simulation)"/>
    <arg name="rviz_config" default="$(var rviz_config_file)" description="rviz config"/>

    <log message="The arguments for aichallenge_system_launch."/>
    <log message=" - simulation: $(var simulation)"/>
    <log message=" - use_sim_time: $(var use_sim_time)"/>
    <log message=" - sensor_model: $(var sensor_model)"/>
    <log message=" - launch_vehicle_interface: $(var launch_vehicle_interface)"/>
    <log message=" - rviz config: $(var rviz_config)"/>
    <log message=" - capture: $(var capture)"/>
    <log message=" - rosbag: $(var rosbag)"/>
    <log message=" - domain_id: $(var domain_id)"/>
    <log message=" - vehicle_count: $(var vehicle_count)"/>
    <log message=" - control_method: $(var control_method)"/>
    <log message=" - tiny_lidar_ckpt_path: $(var tiny_lidar_ckpt_path)"/>
    <log message=" - tiny_lidar_residual_ckpt_path: $(var tiny_lidar_residual_ckpt_path)"/>
    <log message=" - tiny_lidar_residual_architecture: $(var tiny_lidar_residual_architecture)"/>
    <log message=" - tiny_lidar_spatial_shadow_ckpt_path: $(var tiny_lidar_spatial_shadow_ckpt_path)"/>
    <log message=" - tiny_lidar_spatial_shadow_expected_sha256: $(var tiny_lidar_spatial_shadow_expected_sha256)"/>
    <log message=" - tiny_lidar_spatial_shadow_use_base_steering: $(var tiny_lidar_spatial_shadow_use_base_steering)"/>
    <log message=" - tiny_lidar_spatial_shadow_max_abs_delta_rad: $(var tiny_lidar_spatial_shadow_max_abs_delta_rad)"/>
    <log message=" - tiny_lidar_spatial_authority_enabled: $(var tiny_lidar_spatial_authority_enabled)"/>
    <log message=" - tiny_lidar_spatial_authority_max_abs_delta_rad: $(var tiny_lidar_spatial_authority_max_abs_delta_rad)"/>
    <log message=" - tiny_lidar_recurrent_shadow_ckpt_path: $(var tiny_lidar_recurrent_shadow_ckpt_path)"/>
    <log message=" - tiny_lidar_recurrent_shadow_expected_sha256: $(var tiny_lidar_recurrent_shadow_expected_sha256)"/>
    <log message=" - tiny_lidar_recurrent_authority_enabled: $(var tiny_lidar_recurrent_authority_enabled)"/>
    <log message=" - tiny_lidar_recurrent_authority_max_abs_correction_rad: $(var tiny_lidar_recurrent_authority_max_abs_correction_rad)"/>
    <log message=" - tiny_lidar_control_mode: $(var tiny_lidar_control_mode)"/>
    <log message=" - tiny_lidar_acceleration: $(var tiny_lidar_acceleration)"/>

    <!-- Main module of AI challenge 2025. -->
    <include file="$(find-pkg-share aichallenge_submit_launch)/launch/aichallenge_submit.launch.xml" >
        <arg name="simulation" value="$(var simulation)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
        <arg name="sensor_model" value="$(var sensor_model)"/>
        <arg name="launch_vehicle_interface" value="$(var launch_vehicle_interface)"/>
        <arg name="control_method" value="$(var control_method)"/>
        <arg name="tiny_lidar_ckpt_path" value="$(var tiny_lidar_ckpt_path)"/>
        <arg name="tiny_lidar_residual_ckpt_path" value="$(var tiny_lidar_residual_ckpt_path)"/>
        <arg name="tiny_lidar_residual_architecture" value="$(var tiny_lidar_residual_architecture)"/>
        <arg name="tiny_lidar_spatial_shadow_ckpt_path" value="$(var tiny_lidar_spatial_shadow_ckpt_path)"/>
        <arg name="tiny_lidar_spatial_shadow_expected_sha256" value="$(var tiny_lidar_spatial_shadow_expected_sha256)"/>
        <arg name="tiny_lidar_spatial_shadow_use_base_steering" value="$(var tiny_lidar_spatial_shadow_use_base_steering)"/>
        <arg name="tiny_lidar_spatial_shadow_max_abs_delta_rad" value="$(var tiny_lidar_spatial_shadow_max_abs_delta_rad)"/>
        <arg name="tiny_lidar_spatial_authority_enabled" value="$(var tiny_lidar_spatial_authority_enabled)"/>
        <arg name="tiny_lidar_spatial_authority_max_abs_delta_rad" value="$(var tiny_lidar_spatial_authority_max_abs_delta_rad)"/>
        <arg name="tiny_lidar_recurrent_shadow_ckpt_path" value="$(var tiny_lidar_recurrent_shadow_ckpt_path)"/>
        <arg name="tiny_lidar_recurrent_shadow_expected_sha256" value="$(var tiny_lidar_recurrent_shadow_expected_sha256)"/>
        <arg name="tiny_lidar_recurrent_authority_enabled" value="$(var tiny_lidar_recurrent_authority_enabled)"/>
        <arg name="tiny_lidar_recurrent_authority_max_abs_correction_rad" value="$(var tiny_lidar_recurrent_authority_max_abs_correction_rad)"/>
        <arg name="tiny_lidar_control_mode" value="$(var tiny_lidar_control_mode)"/>
        <arg name="tiny_lidar_acceleration" value="$(var tiny_lidar_acceleration)"/>
    </include>

    <!-- Visualization. -->
    <group if="$(var run_rviz)">
        <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" args="-d $(var rviz_config) -s $(find-pkg-share aichallenge_system_launch)/rviz/image/autoware.png"/>
    </group>

    <!-- Initial Pose -->
    <node pkg="topic_tools" exec="relay" name="initial_pose_relay">
      <param name="input_topic" value="/initialpose"/>
      <param name="output_topic" value="/localization/initial_pose3d"/>
    </node>

    <!-- Adapters for simulation. -->
    <group if="$(var simulation)">
        <include file="$(find-pkg-share aichallenge_system_launch)/launch/mode/awsim.launch.xml">
            <arg name="capture" value="$(var capture)"/>
            <arg name="rosbag" value="$(var rosbag)"/>
        </include>
    </group>

    <!-- Adapters for real vehicle. -->
    <group unless="$(var simulation)">
        <include file="$(find-pkg-share aichallenge_system_launch)/launch/mode/real.launch.xml"/>
    </group>

    <!-- V2X visualization (per-vehicle, only on non-base domains). -->
    <group if="$(eval $(var domain_id)!=0)">
        <include file="$(find-pkg-share aichallenge_system_launch)/launch/mode/v2x.launch.xml"/>
    </group>

    <!-- AWSIM's native fanout emits no array when a single-vehicle scenario has no peers.
         Publish an explicit empty observation only where the launch layer proves that the
         simulated world contains exactly one vehicle. NoData remains a controller fault. -->
    <group if="$(var simulation)">
        <group if="$(eval $(var vehicle_count)==1)">
            <include file="$(find-pkg-share aichallenge_system_launch)/launch/mode/single_vehicle_empty_v2x.launch.xml">
                <arg name="use_sim_time" value="$(var use_sim_time)"/>
            </include>
        </group>
    </group>
</launch>
